# Copy to .env.local for local use; set the same variables in Vercel.

# Public base URL of the site, used for canonical links, hreflang and sitemap.
# On Vercel, set this for Production to your domain, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Optional: upload product photos to Cloudinary with `npm run images:sync`.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME (keep it secret; only needed
# on the computer that runs images:sync, not on Vercel).
CLOUDINARY_URL=

# Optional: force draft products on/off. Default: shown everywhere except the
# Vercel production deployment.
# CATALOG_SHOW_DRAFTS=false
